# GZMO — Sovereign Agent Configuration (template)
# ─────────────────────────────────────────────────────────────────────────
#
# Setup:
#   cp gzmo.toml.example gzmo.toml
#   cp .env.template .env          # fill in NEO4J_PASSWORD and API keys
#
# Secrets live in `.env` only — never commit `.env` or `gzmo.toml`.

[identity]
soul_path = "SOUL.md"

[memory]
directory = "memory"
vault_db = "data/vault.db"
vault_backend = "sqlite"

[skills]
directory = "skills"
dreams_path = "DREAMS.md"

# autoDream consolidation. The verifier is the front line against hallucinated
# dreams becoming hallucinated wisdom: every extracted entity/relation is
# fact-checked against the source log and must be backed by a quotable span
# scoring >= min_confidence, or it is dropped instead of written to the graph.
# DreamEngine — gated nightly consolidation (replaces headless auto_dream job)
[dreams]
enabled = true
verify = true
min_confidence = 0.85
# Near-deterministic decoding for the fact-checker, regardless of engine temp.
verify_temperature = 0.1
require_evidence = true
strict_kg = true
# UTC: consolidate yesterday's episodic log once per day (was hardcoded 01:00 in daemon).
cron_hour = 1
cron_minute = 0
# Max chars per REM/verify chunk for heavy daily logs.
chunk_chars = 12000
# Drop janitor/spark/ingest echoes from episodic before REM (research docs use ingest).
min_consolidation_chars = 400
max_tokens_extract = 16384
max_tokens_verify = 8192
# M3: REM also reads honeypot anchors + vector-associated distillates (not episodic-only).
honeypot_rem_enabled = true

# Chat sessions → SessionDistill vault facts + 📓 episodic (feeds dream).
[session_distill]
enabled = true
sessions_dir = "data/sessions"
# Extract + summary on Prime; fact-check on Prime.
use_librarian = false
librarian_summary = true
# Nightly in daemon (02:15 UTC — after Qdrant sync 01:45; same-night mirror gap).
daemon_scheduled = true
cron_hour = 2
cron_minute = 15

# SparkEngine — gated serendipitous recall (replaces headless orchestrator spark job)
[spark]
enabled = true
verify = true
min_confidence = 0.85
hypothesis_temperature = 0.2
verify_temperature = 0.1
candidate_limit = 8
recent_limit = 4
quarantine_confidence = 0.6
# Off-peak cron — avoids competing with Prime during work hours.
schedule_mode = "cron"
cron_hours = [3, 22]
cron_minute = 30
dice_min_minutes = 20
dice_max_minutes = 180
max_tokens_hypothesis = 4096
# Qwen3.6 thinking can consume the whole budget in reasoning_content; 1024 left verify JSON empty.
max_tokens_verify = 4096
max_connection_chars = 1200
min_citation_chars = 12
max_session_anchor_age_days = 14
# Smart anchors: CuratedVault (+ SessionDistill when present), scored stale window, embedding pre-filter.
anchor_decay_classes = ["CuratedVault", "SessionDistill"]
anchor_min_stale_days = 0
anchor_max_stale_days = 60
# Anchors need promoted_at at least this old (RFC3339; pool SQL uses datetime(promoted_at)).
# 0 = allow anchors same day after backfill (dev/smoke); set 6 for production cadence.
anchor_min_age_hours = 0
recent_max_age_hours = 72
min_anchor_recent_similarity = 0.35
recent_dedupe_similarity = 0.92
anchor_refresh_enabled = true
anchor_refresh_min_recent = 4

# Pedagogy tension oscillation — setpoint-controlled chaos_val cycle (0.9→0.5→0.9).
# Start via `gzmo pedagogy oscillate start`; requires enabled = true and daemon running.
[pedagogy.tension_oscillation]
enabled = false
schedule_mode = "manual"
spawn_discovery_on_low = true
low_phase_threshold = 0.55
cooldown_secs = 3600
blend_ticks = 8

[[pedagogy.tension_oscillation.sequence]]
target = 0.9
duration_secs = 60
label = "High tension — confirmation machine"

[[pedagogy.tension_oscillation.sequence]]
target = 0.5
duration_secs = 60
label = "Low tension — discovery machine"

[[pedagogy.tension_oscillation.sequence]]
target = 0.9
duration_secs = 60
label = "High tension — confirmation machine"

[health]
strict_startup = false

# VM200 retrieval router embed preset (:8081).
[embeddings]
enabled = true
url = "http://192.168.31.110:8081/v1"
model = "gzmo-embed"
api_key = ""
cache_ttl_secs = 86400

# SQLite remains source of truth; sync vectors to LXC101 for shared RAG / future Pi.
[qdrant]
enabled = true
url = "http://192.168.31.202:6333"
collection = "honeypot"
sync_enabled = true
sync_cron_hour = 1
sync_cron_minute = 45

# Platform memory cross-search — honeypot vault + Pi knowledge Qdrant (read-only).
[platform_search]
include_knowledge_collection = true
knowledge_collection = "knowledge"
knowledge_prefetch = 12

# Neo4j shared ontology reconcile (MCP memory). Start dry_run=true; set false after review.
[kg_reconcile]
enabled = true
cron_hour = 4
cron_minute = 0
dry_run = true

# Read-only Pi Synapse tail → episodic (append-only bus never consumed for state).
[synapse_pull]
enabled = true
cron_hour = 2
cron_minute = 45
max_events = 50
bus_path = "data/Synapse/events.jsonl"

# Retired VM200 :8083 — distill uses Prime via routing.
[librarian]
enabled = false
url = "http://192.168.31.110:8083/v1"
model = "qwen2.5-coder-1.5b-instruct-q4_k_m.gguf"
api_key = ""

# VM200 retrieval router rerank preset (same :8081 host).
[rerank]
enabled = true
url = "http://192.168.31.110:8081/v1"
model = "gzmo-rerank"
api_key = ""
prefetch_multiplier = 4

# IngestEngine — gated knowledge-folder ingest (replaces headless watcher loop)
[ingest]
enabled = true
max_source_chars = 120000
chunk_chars = 28000
verify = true
min_confidence = 0.85
verify_temperature = 0.1
require_evidence = true
strict_kg = true

# WikiLayer — git-tracked markdown synthesis (browsable in Obsidian).
# Sits between raw RAG (gzmo_memory_search/Qdrant) and DREAMS.md consolidation.
# Phase 2: a Rust WikiEngine emits pages on ingest, and runs daemon "Knowledge
# Gardener" sync/lint loops. Retrieval is emit-only (grep over wiki/*.md via
# `gzmo wiki search` / gzmo_wiki_search MCP) — pages are never re-ingested.
[wiki]
enabled = true
directory = "wiki"
index_path = "wiki/index.md"
log_path = "wiki/log.md"
schema_path = "WIKI.md"
# When true, ingest mirrors newly promoted vault facts into wiki pages.
emit_on_ingest = true
# Daemon Knowledge Gardener: daily index sync (UTC) after Qdrant sync (01:45).
sync_cron_hour = 5
sync_cron_minute = 30
# Weekly structural lint (UTC weekday 0=Sun, hour).
lint_cron_dow = 0
lint_cron_hour = 6

# ─────────────────────────────────────────────────────────────────────────
# API Keys — centralized key management for cloud services
# ─────────────────────────────────────────────────────────────────────────
#
# Keys can also be set via environment variables:
#   GZMO_SERPAPI_KEY, GZMO_OPENROUTER_KEY, GZMO_GEMINI_KEY
# Env vars take precedence over values here.

[api_keys]
serpapi     = ""
openrouter  = ""
gemini      = ""

# ─────────────────────────────────────────────────────────────────────────
# Engine — Dual-mode LLM Configuration
# ─────────────────────────────────────────────────────────────────────────
#
# active_mode: "local" | "cloud"
#   Switch at runtime with: /mode cloud  or  /mode local
#   Changes are persisted to this file.

[engine]
active_mode = "local"

# ─── Local Engine Profile ────────────────────────────────────────────────
# Targets any OpenAI-compatible local endpoint:
# llama.cpp, Ollama, LM Studio, vLLM

[engine.local]
provider    = "local"
# Brain = the workstation Prime engine: Qwen3.6-35B-A3B MoE (~3B active params)
# on the dual RTX 5070 Ti, launched via llama.cpp/prime-bench/start-prime.sh.
# Fast (140+ tok/s) AND high quality — the real local production model, NOT Opus,
# so its output is the honest quality signal. (The VM200 7B eGPU was too slow for
# agentic tool-calling: 9 min with no first token, so we moved cognition here.)
url         = "http://localhost:8000/v1"
model       = "qwen3.6-35b-mtp"
api_key     = ""
temperature = 0.3
top_p       = 0.95
# 24k output budget: dream extraction of a dense document can emit dozens of
# entities + relations as one JSON object; 8k truncated mid-array and aborted
# the whole cycle. Kept as a bounded guardrail (not the full 128k ctx) so a
# runaway/looping generation fails fast. Large docs use IngestEngine chunking.
max_tokens  = 24576

# Sovereign 3×7B FrankenMoE — DEPRIORITIZED (broken MoE output). Leave :8010 down.
# `/mode sovereign` only after a working GGUF + llama-server fix.
[engine.sovereign]
provider    = "local"
url         = "http://localhost:8010/v1"
model       = "sovereign-moe"
api_key     = ""
temperature = 0.3
top_p       = 0.95
max_tokens = 8192

# ─── Cloud Engine Profile ───────────────────────────────────────────────
# Primary: OpenRouter (OpenAI-compatible, routes to any model)
# Fallback: Google Gemini API (direct)

[engine.cloud]
provider      = "gemini"
url           = "https://generativelanguage.googleapis.com/v1beta/openai"
model         = "gemini-2.5-flash"
api_key       = ""
temperature   = 0.4
top_p         = 0.95
max_tokens    = 8192

# Fallback engine — auto-activated if primary cloud endpoint fails
fallback_provider  = "gemini"
fallback_url       = "https://generativelanguage.googleapis.com/v1beta/openai"
fallback_model     = "gemini-2.5-flash"
fallback_api_key   = ""

[agent]
max_tool_iterations = 10
heartbeat_interval_secs = 1800  # 30 minutes

# ─────────────────────────────────────────────────────────────────────────
# MCP Servers
# ─────────────────────────────────────────────────────────────────────────
#
# Each [[mcp_servers]] entry spawns a child process on startup.
# Tools are auto-discovered and registered as mcp__{name}__{tool_name}.

# Knowledge-graph memory → sidecar Neo4j (LXC101, 192.168.31.202).
# Resurrects the dream Deep-phase KG write, which calls mcp__memory__*.
# The tool name prefix is derived from `name` below (mcp__memory__*), so it
# must stay "memory" to match dreams.rs / the boot read_graph call.
# Prereq on this host: `uv` (pip install uv) so `uvx` can fetch the server.
[[mcp_servers]]
name = "memory"
# Absolute path recommended: daemon spawns via PATH-less exec.
command = "/home/YOUR_USER/.local/bin/uvx"
args = ["mcp-neo4j-memory@0.4.5"]

# Credentials: set in `.env` (see `.env.template`). Env vars override these defaults.
[mcp_servers.env]
NEO4J_URL = "bolt://192.168.31.202:7687"
NEO4J_USERNAME = "neo4j"
NEO4J_PASSWORD = ""
NEO4J_DATABASE = "neo4j"

# Example:
#
# [[mcp_servers]]
# name = "browser"
# command = "npx"
# args = ["-y", "@anthropic/mcp-server-puppeteer"]
# disabled = true   # skip this server on startup

# MCP "everything" test server — uncomment to verify MCP integration
# [[mcp_servers]]
# name = "test"
# command = "npx"
# args = ["-y", "@modelcontextprotocol/server-everything"]

# ─────────────────────────────────────────────────────────────────────────
# Scratch cache + context archive (Redis LXC101 :6379)
# ─────────────────────────────────────────────────────────────────────────

[redis]
enabled = true
url = "redis://192.168.31.202:6379"
distill_queue = "gzmo:distill:pending"
distill_fallback_dir = "data/distill-queue"

[context_memory]
archive_threshold = 0.90
response_reserve = 0.10
scratch_max_tokens = 2000
context_length = 131072

[context_compress]
enabled = false
ccr_ttl_secs = 3600
tool_output_max_tokens = 4000
recall_compress_budget = 2000
json_array_row_cap = 20
log_line_cap = 500

[subagent]
enabled = true
max_concurrent = 2
max_depth = 2
context_budget_tokens = 32768
summary_max_tokens = 800

# ─────────────────────────────────────────────────────────────────────────
# Background Orchestration (Daemon Mode)
# ─────────────────────────────────────────────────────────────────────────
#
# Each job runs on a cron schedule (6-field: sec min hour day month weekday).
# When a job fires, a headless GZMO instance processes the prompt using
# all available tools, then logs the result to episodic memory.
#
# Start daemon mode with: sovereign-agent --daemon

# [orchestration.jobs.morning_brief]
# cron = "0 0 6 * * *"
# prompt = "Search the web for the latest tech and finance headlines. Write a concise morning briefing."

[orchestration.jobs.sys_janitor]
cron = "0 */30 * * * *"
prompt = "Use the sys_metrics tool to examine my local machine's disk, ram, and cpu. If you detect critical anomalies or see a dangerous unassociated process eating CPU, you are authorized to use sys_kill to terminate it. Keep a concise log of your findings in the knowledge vault."

# WikiLayer maintenance — Phase 2: the Rust WikiEngine runs as daemon loops on
# [wiki].sync_cron_* / lint_cron_*. The prompt jobs below are kept DISABLED so
# cron work is not duplicated (mirrors auto_dream / spark / kg_reconcile).
[orchestration.jobs.wiki_sync]
disabled = true
cron = "0 30 5 * * *"
prompt = "(legacy — daemon runs WikiEngine sync on [wiki].sync_cron_*)"

[orchestration.jobs.wiki_lint]
disabled = true
cron = "0 0 6 * * 0"
prompt = "(legacy — daemon runs WikiEngine lint on [wiki].lint_cron_*)"

[orchestration.jobs.test_pulse]
# Fire every 20 seconds
cron = "*/20 * * * * *"
prompt = "Check the current time using bash date. Write a short, single-sentence thought confirming the daemon is awake."
disabled = true

# KG reconcile + Synapse pull run as dedicated daemon loops ([kg_reconcile], [synapse_pull]).
# Legacy prompt jobs kept disabled — do not duplicate cron work.
[orchestration.jobs.kg_reconcile]
disabled = true
cron = "0 0 4 * * 0"
prompt = "(legacy — daemon runs [kg_reconcile] loop)"

[orchestration.jobs.synapse_pull]
disabled = true
cron = "0 45 2 * * *"
prompt = "(legacy — daemon runs [synapse_pull] loop)"

# Knowledge folder watcher — uses IngestEngine when [ingest].enabled (daemon).
# Legacy prompt below is only used if ingest is disabled.
[orchestration.watchers.inbox_ingest]
disabled = true
directory = "/home/maximilian-wruhs/Schreibtisch/knowledge"
prompt = "(legacy headless fallback — IngestEngine handles ingest when [ingest].enabled)"

# ─────────────────────────────────────────────────────────────────────────
# Chaos Engine — Lorenz Attractor + Thought Cabinet
# ─────────────────────────────────────────────────────────────────────────
#
# Physics derived from the original Randomizer v2.1 daemon.
# Tension is driven by live CPU/RAM hardware telemetry.

[chaos]
gravity = 9.8       # Original Randomizer value
friction = 0.5      # Original Randomizer value (was 0.7 in hardcoded default)
seed = 0.506        # Lorenz's historical input value
initial_tension = 0.0  # Let hardware telemetry drive tension from tick 1
lore_path = "data/lore.toml"
# Per-tick multiplicative decay on lorenz_rho_mod (~4 min half-life at 0.001).
# Set to 0.0 to restore legacy behavior (no decay). Used when rho_restore_alpha = 0.
rho_decay_k = 0.001
# Tanh governor (chaos-breathing-lab winner: max ρ 0.93 vs 5.99 on active_story_30s).
# Recommended default for superior parameter stability. Replaces linear decay.
rho_restore_alpha = 0.01
rho_restore_beta = 1.0
# EMA smoothing gain for rho_breath_phase (0.2 = moderate memory across ticks).
rho_ema_gamma = 0.2
# The amount by which to adjust Lorenz ρ mod when /stabilize is invoked (default: -1.0).
stabilize_delta_rho = -1.0

[chaos.events]
joke_chance = 0.3   # Probability window for joke emission per tick
quote_chance = 0.4  # Probability window for quote emission
fact_chance = 0.3   # Probability window for fact emission

# ─────────────────────────────────────────────────────────────────────────
# autoDream — DISABLED (use DreamEngine via [dreams] in daemon / `gzmo dream`)
# ─────────────────────────────────────────────────────────────────────────
#
# The headless prompt duplicated DreamEngine at 03:00 while the daemon already
# ran gated consolidation at 01:00. Scheduling lives in [dreams].cron_hour/minute.

[orchestration.jobs.auto_dream]
disabled = true
cron = "0 0 3 * * *"
persist_results = false
max_retries = 0
prompt = "(legacy — use `gzmo dream` or DreamEngine in daemon)"

# ─────────────────────────────────────────────────────────────────────────
# Spark — chaos-free serendipity (the "dice that revisits something old")
# ─────────────────────────────────────────────────────────────────────────
#
# This is the piece you originally wanted INSTEAD of the chaos engine:
# a cron that periodically wakes, picks something OLD from the brain, and
# makes a NEW connection. No Lorenz attractor, no inference-state coupling.
#
#   • "WHEN"  = the cron cadence below (3 jittered times/day). Deterministic,
#               debuggable. That is the only "dice".
#   • "WHAT"  = the agent samples a stale / under-connected node from the
#               knowledge graph via mcp__memory__ tools (now live → Neo4j),
#               then writes a fresh reflection linking it to recent memory.
#
# Decoupled from [chaos] on purpose — it shares no state with the attractor.
# DISABLED: daemon runs SparkEngine on [spark].cron_hours / cron_minute instead.
# WikiLayer hook (Phase 2, WikiEngine): in addition to the `## Spark` section in
# DREAMS.md, spark may drop a reflective [[wikilink]] note into the relevant
# wiki/ page so serendipitous connections compound there too (see WIKI.md).
[orchestration.jobs.spark]
disabled = true
cron = "0 17 9,14,21 * * *"
persist_results = false
max_retries = 0
prompt = "(legacy — use `gzmo spark` or SparkEngine in daemon)"

# ─────────────────────────────────────────────────────────────────────────
# Obolus — Static Task → Engine Routing Table
# ─────────────────────────────────────────────────────────────────────────
#
# Maps each cognitive task to an engine profile. The routing is
# configuration-level only — no live benchmarking, no dynamic recalcs.
#
# Task kinds: dream_extract, dream_verify, spark_hypothesis, spark_verify,
#             ingest_extract, distill_extract, distill_verify, distill_summary
#
# Profile names resolve to: engine.local / engine.cloud / engine.sovereign
# or inline [routing.profiles.<name>] blocks, or the librarian shortcut.

[routing]
default_engine = "local"
# Cloud-first background cognition (optional, default false): when true, every
# background TaskKind (all except chat) tries [engine.cloud] first, then falls
# back to its [routing.mappings] profile below if the cloud endpoint is down.
# Interactive chat is unaffected (use /mode to switch the chat engine).
cloud_first_background = false

[routing.mappings]
# These are the LEGACY / FALLBACK targets. With cloud_first_background = true
# they are used only when the cloud endpoint is unreachable.
# Dream: extract on Prime (heavy KG), verify on Prime (fact-check)
dream_extract = "local"
dream_verify = "local"
# Spark: hypothesis + verify on Prime (local profile — not librarian)
spark_hypothesis = "local"
spark_verify = "local"
# Ingest: extract + verify on Prime (decoupled from dream_verify)
ingest_extract = "local_deterministic"
ingest_verify = "local"
# Distill: extract + summary on librarian (light), verify on Prime (accuracy)
distill_extract = "local"
distill_verify = "local"
distill_summary = "local"
# Kurator phase 2 only (not wired in phase 1):
# agent_monitor = "local_deterministic"
# agent_spawn = "local"

[obolus_analytics]
enabled = true
ledger_path = "data/Obolus/ledger.jsonl"
power_ledger_path = "data/Obolus/power.jsonl"
# llama_log_path = ""   # journalctl wrapper or --log-file path for Pi/external reconcile
prime_port = 8000
prime_context_tokens = 131072   # Prime n_ctx (128K) — not [context_memory].context_length
reconcile_interval_secs = 60
tokens_per_obl = 1000
efficiency_tick_enabled = true
# Hardware energy bridge (observability-only; gates remain token-based)
energy_sampler_enabled = false
hsp_state_url = "http://127.0.0.1:8001/state"
nvidia_smi_fallback = true
gpu_joules_integration = true
energy_sample_min_interval_secs = 55
rapl_energy_path = "/sys/class/powercap/intel-rapl:0/energy_uj"

[obolus_governance]
enabled = true
max_e_total_per_hour = 2000000
max_ctx_pressure_pct = 500          # headroom over chat-heavy hours (~320% typical)
spawn_discovery_fix_reserve_obl = 50
spawn_session_triage_reserve_obl = 20
dice_loop_reserve_obl = 10
on_budget_exceeded = "deny"
operator_warn_only = true
fail_open_if_ledger_unreadable = false

[compliance]
mode = "sovereign"
require_obolus_governance = true
allow_cloud_tools = false
allow_cloud_engine = false
trusted_cidrs = ["127.0.0.0/8", "192.168.31.0/24"]
max_binary_mb = 80
max_workspace_deps = 25

[kurator]
enabled = false
max_turns_before_recommend = 40
max_session_tokens = 500000
skill_error_rate_threshold = 0.3
max_dice_loops_per_hour = 12
default_agent_profile = "prometheus"
approve_spawns_subagent = true
auto_spawn_on_recommend = true
spawn_brief_max_chars = 4000
# Opt-in: spawn fixer/implementer in ephemeral git worktrees under $GZMO_SKILLS_ROOT/.worktrees/
fixer_worktree_isolation = false


[kurator.spawn_gate]
enabled = true
max_autospawns_per_hour = 3
spawn_cooldown_secs = 600
prometheus_requires_idle = true
duplicate_reason_max_per_hour = 3
auto_spawn_discovery_fix = true
prime_budget_enabled = true
prime_spawn_budget_per_hour = 3
prime_budget_fail_open = false
prime_budget_ttl_secs = 7200

[synapse_writer]
# When true, `gzmo chaos skill` requires a matching Pi `skill.invoke` on the bus.
gate_enabled = false
invoke_window_secs = 120
tail_scan_lines = 2000

[bibliothek]
min_dream_cycles = 50

[routing.profiles.local_deterministic]
provider    = "local"
url         = "http://localhost:8000/v1"
model       = "qwen3.6-35b-mtp"
api_key     = ""
temperature = 0.1
top_p       = 0.95
max_tokens  = 24576