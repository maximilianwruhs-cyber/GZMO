# Living appliance secrets — copy to .env (gitignored) and fill in.
# Never commit real passwords. Never put NEO4J_AUTH in docker-compose.yml.

# Format required by Neo4j image: user/password
NEO4J_AUTH=neo4j/change-me-strong-password

# Optional memory (defaults match CT101 8 GiB co-tenant sizing)
# NEO4J_HEAP_INIT=1500m
# NEO4J_HEAP_MAX=1500m
# NEO4J_PAGECACHE=1500m
