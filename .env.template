# GZMO Sovereign Agent — Environment Configuration Template
# ─────────────────────────────────────────────────────────────────────────
#
# Setup:
#   cp .env.template .env
#   Fill in secrets below. Never commit `.env`.
#
# Process env vars take precedence over `.env`.
# GZMO loads this file automatically when reading gzmo.toml.

# ─── GraphRAG Memory Stack (MCP Neo4j) ────────────────────────────────────
NEO4J_URL=bolt://192.168.31.202:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j

# ─── Cloud API Keys ───────────────────────────────────────────────────────
# Override [api_keys] and [engine.cloud] in gzmo.toml
GZMO_SERPAPI_KEY=
GZMO_OPENROUTER_KEY=
GZMO_GEMINI_KEY=
