# GZMO Sovereign Agent — Environment Configuration Template
# ─────────────────────────────────────────────────────────────────────────
#
# Copy this file to '.env' and populate with your credentials.
# The GZMO daemon and CLI will automatically ingest these variables,
# overriding any hardcoded values inside 'gzmo.toml'.
#
# DO NOT COMMIT THE COMPLETED '.env' FILE TO VERSION CONTROL!
# Make sure '.env' is added to your '.gitignore'.

# ─── GraphRAG Memory Stack ───────────────────────────────────────────────
NEO4J_URL=bolt://192.168.31.202:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j

# ─── Centralized API Keys & Cloud Gateways ────────────────────────────────
# Env overrides for GZMO's centralized API key management:
# Maps to [api_keys] and [engine.cloud] profiles in gzmo.toml.
GZMO_SERPAPI_KEY=your_serpapi_key_here
GZMO_OPENROUTER_KEY=your_openrouter_key_here
GZMO_GEMINI_KEY=your_gemini_key_here
