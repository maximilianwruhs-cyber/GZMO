[Unit]
Description=GZMO Prime (HauhauCS Qwen3.6-35B uncensored IQ4_XS @ 128K on :8000)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=%h/Projects/llama.cpp/prime-bench
Environment=GGML_CUDA_DISABLE_GRAPHS=1
ExecStart=%h/Projects/llama.cpp/prime-bench/start-prime-qwen-hauhaucs-iq4xs-256k.sh
Restart=on-failure
RestartSec=30
TimeoutStartSec=900

[Install]
WantedBy=default.target
