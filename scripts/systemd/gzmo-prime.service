[Unit]
Description=GZMO Prime (Gemma 4 26B-A4B MoE @ 256K + MTP on :8000)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=%h/Projects/llama.cpp/prime-bench
Environment=GGML_CUDA_DISABLE_GRAPHS=1
ExecStart=%h/Projects/llama.cpp/prime-bench/start-prime-gemma4-26b-a4b-256k.sh
Restart=on-failure
RestartSec=30
TimeoutStartSec=900

[Install]
WantedBy=default.target
