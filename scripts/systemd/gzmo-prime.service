[Unit]
Description=GZMO Prime (Huihui Qwen3.6-27B quality @ 64K on :8000)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=%h/Projects/llama.cpp/prime-bench
Environment=GGML_CUDA_DISABLE_GRAPHS=1
Environment=PRIME_CTX=65536
Environment=PRIME_PROFILE_LABEL=quality-nightshift
ExecStart=%h/Projects/llama.cpp/prime-bench/start-prime-huihui-qwen36-27b-quality-64k.sh
Restart=on-failure
RestartSec=30
TimeoutStartSec=900

[Install]
WantedBy=default.target
