[Unit]
Description=GZMO retrieval router (Qwen3 embed + rerank) on GTX 1070 :8081
After=network.target

[Service]
Type=simple
User=maximilian
Group=maximilian
Environment=LD_LIBRARY_PATH=/usr/local/lib
ExecStart=/usr/local/bin/llama-server \
  --models-preset /opt/models/gzmo-retrieval.ini \
  --models-max 2 \
  --host 0.0.0.0 \
  --port 8081
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
