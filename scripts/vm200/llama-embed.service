[Unit]
Description=GZMO consolidated retrieval server (embed + rerank) on GTX 1070
After=network.target

[Service]
Type=simple
User=maximilian
Group=maximilian
Environment=LD_LIBRARY_PATH=/usr/local/lib
ExecStart=/usr/local/bin/llama-server \
  -m /opt/models/Qwen3-Reranker-0.6B.F16.gguf \
  --embedding \
  --pooling rank \
  --reranking \
  --alias gzmo-rerank \
  --embeddings \
  --pooling last \
  --alias gzmo-embed \
  -ngl 99 \
  -c 2048 \
  --parallel 1 \
  --flash-attn on \
  --port 8081 \
  --host 0.0.0.0
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
