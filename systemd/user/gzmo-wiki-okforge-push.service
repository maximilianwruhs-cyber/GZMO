[Unit]
Description=GZMO OKForge wiki satellite (living honeypot dump → local forge)
After=network-online.target
# Never pair with gzmo-serve. Refuse dual-writer inside the script.

[Service]
Type=oneshot
WorkingDirectory=%h/gzmo_full
Environment=CT101_SSH_HOST=ct101
ExecStart=/bin/bash %h/gzmo_full/scripts/wiki-okforge-living-push.sh
Nice=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
