[Unit]
Description=GZMO research-sota (nightly SOTA/deep-research: arXiv/GitHub/HF → synthesis)
After=network-online.target llama-prime.service

[Service]
Type=oneshot
WorkingDirectory=%h/github-clone/GZMO
Environment=CT101_SSH_HOST=ct101
ExecStart=/bin/bash %h/github-clone/GZMO/scripts/research-sota.sh
Nice=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
