[Unit]
Description=CT101 living product smoke (via SSH from workstation)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/github-clone/GZMO
Environment=CT101_SSH_HOST=ct101
ExecStart=/bin/bash %h/github-clone/GZMO/scripts/ct101-living-smoke.sh
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
