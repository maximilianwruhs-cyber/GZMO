{
  "$id": "https://gzmo.dev/schemas/evolution/evaluation-v1.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "CandidateId": {
      "maxLength": 96,
      "minLength": 16,
      "pattern": "^cand-[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
      "type": "string"
    },
    "GateClass": {
      "description": "Classification of an evaluation gate.",
      "enum": [
        "hard_floor",
        "metric"
      ],
      "type": "string"
    },
    "GateResult": {
      "additionalProperties": false,
      "description": "One gate observation attached to an evaluation report.",
      "properties": {
        "artifact_digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": [
            "string",
            "null"
          ]
        },
        "class": {
          "$ref": "#/definitions/GateClass"
        },
        "detail": {
          "maxLength": 4096,
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$",
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/GateStatus"
        }
      },
      "required": [
        "class",
        "detail",
        "name",
        "status"
      ],
      "title": "GateResult",
      "type": "object"
    },
    "GateStatus": {
      "description": "Outcome of a single evaluation gate.",
      "enum": [
        "pass",
        "fail",
        "unavailable"
      ],
      "type": "string"
    }
  },
  "description": "Comparative evaluation of a candidate against its baseline.",
  "properties": {
    "artifact_digests": {
      "additionalProperties": {
        "type": "string"
      },
      "type": "object"
    },
    "baseline_digest": {
      "pattern": "^(sha256:[a-f0-9]{64}|git-sha1:[a-f0-9]{40})$",
      "type": "string"
    },
    "candidate_digest": {
      "pattern": "^(sha256:[a-f0-9]{64}|git-sha1:[a-f0-9]{40})$",
      "type": "string"
    },
    "candidate_id": {
      "$ref": "#/definitions/CandidateId"
    },
    "completed_at": {
      "format": "date-time",
      "type": "string"
    },
    "gates": {
      "items": {
        "$ref": "#/definitions/GateResult"
      },
      "minItems": 1,
      "type": "array"
    },
    "hard_floors_passed": {
      "type": "boolean"
    },
    "metrics": {
      "additionalProperties": {
        "format": "double",
        "type": "number"
      },
      "type": "object"
    },
    "schema": {
      "pattern": "^gzmo\\.evolution\\.evaluation/v1$",
      "type": "string"
    }
  },
  "required": [
    "artifact_digests",
    "baseline_digest",
    "candidate_digest",
    "candidate_id",
    "completed_at",
    "gates",
    "hard_floors_passed",
    "metrics",
    "schema"
  ],
  "title": "EvaluationReport",
  "type": "object",
  "x-gzmo-runtime-validation": [
    "recomputed-evaluation-verdict: hard_floors_passed must equal hard_floors_pass() over gate observations",
    "gates must include at least one hard_floor class and unique names (partially beyond minItems)",
    "runtime Deserialize/validate remains authoritative; schema does not recompute verdicts"
  ],
  "x-gzmo-schema-id": "gzmo.evolution.evaluation/v1"
}
