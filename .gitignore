# ── Rust ──────────────────────────────────────────────────────────────────
target/

# ── Secrets & local config ───────────────────────────────────────────────
.env
.env.local
*.pem
*.key

# Local operator config (copy from gzmo.toml.example)
gzmo.toml

# ── Runtime / agent state (never commit) ───────────────────────────────────
# Root episodic logs only — do not ignore gzmo-core/src/memory/ (Rust sources).
/memory/
!/memory/.gitkeep
data/vault.db
data/vault.db-*
data/vault.db.pre-*
# M5 derived export (regenerated by scripts/ripen-knowledge-core.py)
data/knowledge_core.db
data/knowledge_core.db-*
data/knowledge_core.candidates.json
data/knowledge_core_export.md
data/sessions/
data/backups/
data/distill-queue/
data/Synapse/
logs/
reports/
DREAMS.md
CHAOS_STATE.json
data/HEARTBEAT.md
data/pi-frontend-session.id
data/synapse-reader.state.json

# Keep static seed data
!data/lore.toml
!data/.gitkeep

# ── GZMO-next instance runtime (config is committed; data is not) ──────────
data-next/*
!data-next/.gitkeep
!data-next/memory/
data-next/memory/*
!data-next/memory/.gitkeep
!data-next/sessions/
data-next/sessions/*
!data-next/sessions/.gitkeep
!data-next/distill-queue/
data-next/distill-queue/*
!data-next/distill-queue/.gitkeep
config/gzmo-next-fused.toml

# ── Models & binaries (large / machine-specific) ───────────────────────────
models/
bin/
bin/*.so*
bin/llama-*

# ── Agent IDE / tooling (local only) ───────────────────────────────────────
.pi/
.Jules/

# ── Python / eval artifacts ────────────────────────────────────────────────
__pycache__/
*.pyc
scripts/ingest-quality/reports/
scripts/ingest-quality/.batch2-corpus/
scripts/ingest-quality/report.json
scripts/ingest-quality/report-batch2.json
scripts/ingest-quality/*.log
scripts/ingest-quality/*.stderr.log
scripts/.venv/
experiments/toto-spike/.venv/
experiments/toto-spike/results/*.pt
experiments/toto-spike/.hf_cache/

# ── Session research docs (local working notes) ────────────────────────────
docs/archive/

# ── Wiki layer (git-tracked on purpose — Obsidian + git review) ─────────────
# Unlike memory/ and data/vault.db, wiki/ markdown IS committed. Only locally
# downloaded source images are ignored.
wiki/assets/
!wiki/.gitkeep
!wiki/**/.gitkeep

# ── OS / editor ────────────────────────────────────────────────────────────
.DS_Store
*.swp
*.swo
*~

# Node (OpenClaw plugins)
node_modules/


# Agent scratch (local, never commit)
.scratch/
